{
  "name": "@crystal-creations/crystal-components",
  "version": "1.0.0-beta.50",
  "type": "module",
  "author": "Servely UG (haftungsbeschränkt)",
  "license": "MIT",
  "description": "A vuetify based component library from Servely",
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "test:release-notes": "node scripts/check-release-notes.js",
    "semantic-release": "semantic-release",
    "build": "vite build",
    "dev": "vite",
    "serve": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic",
    "commitlint": "commitlint"
  },
  "keywords": [
    "vuetify",
    "servely",
    "components"
  ],
  "homepage": "https://github.com/servely/crystal-components",
  "bugs": "https://github.com/servely/crystal-components/issues",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./styles": {
      "default": "./dist/style.css"
    },
    "./nuxt": {
      "default": "./src/nuxt.mjs"
    }
  },
  "repository": "https://github.com/servely/crystal-components",
  "peerDependencies": {
    "@mdi/js": "^7.4.47",
    "vue": "^3.0.0",
    "vue-i18n": "^11.0.0",
    "vuetify": "^3.5.2"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@mdi/js": "7.4.47",
    "@nuxt/kit": "3.21.11",
    "@nuxtjs/eslint-config-typescript": "12.1.0",
    "@nuxtjs/i18n": "10.6.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@storybook/addon-essentials": "7.6.24",
    "@storybook/addon-interactions": "7.6.24",
    "@storybook/addon-links": "7.6.24",
    "@storybook/blocks": "7.6.24",
    "@storybook/testing-library": "0.2.2",
    "@storybook/vue3": "7.6.24",
    "@storybook/vue3-vite": "7.6.24",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "chromatic": "18.14.1",
    "conventional-changelog-conventionalcommits": "7.0.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-storybook": "0.6.15",
    "eslint-plugin-vue": "9.33.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass": "1.107.1",
    "semantic-release": "23.1.1",
    "storybook": "7.6.24",
    "storybook-i18n": "2.0.13",
    "typescript": "6.0.3",
    "vite": "6.4.5",
    "vite-plugin-dts": "3.9.1",
    "vite-plugin-turbosnap": "1.0.3",
    "vue": "3.5.45",
    "vue-i18n": "11.4.18",
    "vuetify": "3.13.7"
  },
  "dependencies": {
    "@crystal-creations/animated-checkmark": "4.0.0-beta.5",
    "@crystal-creations/pulsating-circle": "4.0.0-beta.1"
  }
}
