{
  "name": "@crystal-creations/crystal-components",
  "version": "1.0.0-beta.49",
  "type": "module",
  "author": "Servely UG (haftungsbeschränkt)",
  "license": "MIT",
  "description": "A vuetify based component library from Servely",
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "test:release-notes": "node scripts/check-release-notes.js",
    "semantic-release": "semantic-release",
    "build": "vite build",
    "dev": "vite",
    "serve": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic",
    "commitlint": "commitlint"
  },
  "keywords": [
    "vuetify",
    "servely",
    "components"
  ],
  "homepage": "https://github.com/servely/crystal-components",
  "bugs": "https://github.com/servely/crystal-components/issues",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./styles": {
      "default": "./dist/style.css"
    },
    "./nuxt": {
      "default": "./src/nuxt.mjs"
    }
  },
  "repository": "https://github.com/servely/crystal-components",
  "peerDependencies": {
    "@mdi/js": "^7.4.47",
    "vue": "^3.0.0",
    "vue-i18n": "^9.9.1",
    "vuetify": "^3.5.2"
  },
  "devDependencies": {
    "@commitlint/cli": "18.6.0",
    "@commitlint/config-conventional": "18.6.0",
    "@mdi/js": "7.4.47",
    "@nuxt/kit": "3.10.0",
    "@nuxtjs/eslint-config-typescript": "12.1.0",
    "@nuxtjs/i18n": "8.0.1",
    "@semantic-release/exec": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@storybook/addon-essentials": "7.6.12",
    "@storybook/addon-interactions": "7.6.12",
    "@storybook/addon-links": "7.6.12",
    "@storybook/blocks": "7.6.12",
    "@storybook/testing-library": "0.2.2",
    "@storybook/vue3": "7.6.12",
    "@storybook/vue3-vite": "7.6.12",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "4.6.2",
    "chromatic": "18.14.1",
    "conventional-changelog-conventionalcommits": "7.0.2",
    "eslint": "8.56.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "eslint-plugin-storybook": "^0.6.14",
    "eslint-plugin-vue": "9.21.1",
    "prettier": "3.2.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sass": "1.70.0",
    "semantic-release": "22.0.12",
    "storybook": "7.6.21",
    "storybook-i18n": "~2.0.13",
    "typescript": "5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "3.7.2",
    "vite-plugin-turbosnap": "1.0.3",
    "vue": "3.4.15",
    "vue-i18n": "^9.9.1",
    "vuetify": "3.5.2"
  },
  "dependencies": {
    "@crystal-creations/animated-checkmark": "4.0.0-beta.5",
    "@crystal-creations/pulsating-circle": "4.0.0-beta.1"
  }
}
